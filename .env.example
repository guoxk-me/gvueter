# Browser-visible build configuration only. Never place secrets in Vite variables.
VITE_API_BASE_URL=/api
# gnester-lite keeps Nest URI versioning enabled; paired production builds use /api/v1.
# VITE_API_BASE_URL=/api/v1
VITE_ENABLE_MOCKS=false
# AI modified: realtime is opt-in so a copied template never sends bearer tokens to an example host.
VITE_NOTIFICATION_WS_URL=
VITE_NOTIFICATION_WS_ALLOWED_ORIGINS=
# Cross-origin production example (also add the origin to CSP connect-src):
# VITE_NOTIFICATION_WS_URL=wss://admin.example.com/notifications
# VITE_NOTIFICATION_WS_ALLOWED_ORIGINS=wss://admin.example.com
VITE_NAVIGATION_ALLOWED_ORIGINS=https://docs.example.com,https://support.example.com
