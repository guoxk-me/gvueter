{
  "name": "gvueter",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "run-s type-check build-only check:bundle",
    "preview": "vp preview",
    "test:unit": "vp test",
    "test:coverage": "vp test run --coverage",
    "test:inventory": "node scripts/check-test-inventory.mjs",
    "test:e2e": "playwright test",
    "build-only": "vp build",
    "type-check": "vue-tsc --build",
    "lint": "CI=true eslint . --cache",
    "lint:fix": "CI=true eslint . --fix --cache",
    "format": "vp fmt . --write",
    "check": "vue-tsc --build && CI=true eslint . --cache",
    "check:contracts": "node scripts/check-openapi-contract.mjs && node scripts/check-runtime-api-contracts.mjs",
    "check:security": "node scripts/check-sensitive-files.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "prepare": "vp config"
  },
